# Copy this file to .env and fill only the providers you use.
# Never commit real API keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# llama.cpp local server settings.
# Defaults used by configs/models.example.yaml are shown below.
# Change these when your llama-server uses a different host/port or API alias.
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL_ID=inm-local

# Ollama local server settings.
# Ollama's local API normally listens on port 11434 and requires no API key.
# Set OLLAMA_MODEL_ID to the exact model tag you use with `ollama run`,
# for example: qwen3:8b, gemma3:12b, or another locally installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_ID=
