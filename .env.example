# Copy this file to .env and fill only the providers you use.
# Never commit real API keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# llama.cpp normally does not require an API key.
# If your server is configured with one, set it here and reference this
# environment variable from configs/models.yaml.
LLAMA_CPP_API_KEY=
