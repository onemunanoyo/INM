{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onemunanoyo/INM/blob/main/schema/item.schema.json",
  "title": "INM benchmark item",
  "description": "Schema for one canonical INM JSONL benchmark item.",
  "type": "object",
  "required": [
    "id",
    "display_id",
    "section",
    "group",
    "item",
    "category",
    "subtask",
    "difficulty",
    "question",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^inm_[a-z0-9_]+_[0-9]{3}$"
    },
    "display_id": {
      "type": "string",
      "pattern": "^[1-4]-[A-Z]-\\([1-9][0-9]*\\)$"
    },
    "section": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "group": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "item": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "structure",
        "fake_quote",
        "quote_completion"
      ]
    },
    "subtask": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answer": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "accepted_answers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normalization": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "trim",
          "normalize_width",
          "normalize_spaces",
          "strip_quotes",
          "strip_punctuation"
        ]
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^src_[A-Za-z0-9_-]+$"
      }
    },
    "fake_type": {
      "type": "string",
      "enum": [
        "original_synthetic",
        "quote_blend",
        "word_substitution",
        "speaker_swap",
        "near_miss",
        "cross_meme"
      ]
    },
    "speaker": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "work": {
      "type": "string"
    },
    "quote_type": {
      "type": "string",
      "enum": [
        "verbatim",
        "canonicalized",
        "mishearing",
        "derived",
        "visual_meme",
        "community_term"
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "enum": [
              "character",
              "structure",
              "fake_quote"
            ]
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "required": [
          "choices",
          "answer"
        ],
        "properties": {
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "fake_quote"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "required": [
          "fake_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "quote_completion"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "required": [
          "answer",
          "accepted_answers",
          "normalization"
        ],
        "properties": {
          "section": {
            "const": 4
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "character"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "section": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "structure"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "section": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "fake_quote"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "section": {
            "const": 3
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
